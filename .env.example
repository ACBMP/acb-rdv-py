# Address the game is told to connect to (public IPv4 or hostname).
ACB_RDV_PUBLIC_ADDRESS=203.0.113.10

# AN-API on the host (gunicorn, src/gunicorn_config.py binds 127.0.0.1:8000).
ACB_RDV_ANAPI_URL=http://127.0.0.1:8000
# must equal AN-API's RDV_SERVICE_KEY
ACB_RDV_ANAPI_SERVICE_KEY=change-me
# must equal AN-API's RDV_NOTIFY_KEY
ACB_RDV_INTERNAL_KEY=change-me-too

# Ports (host networking: these are opened on the host itself).
ACB_RDV_AUTH_PORT=21030
ACB_RDV_SECURE_PORT=21031
ACB_RDV_STATUS_PORT=21032
# 127.0.0.1 when AN-API runs on this machine; 0.0.0.0 (firewalled) when it is elsewhere
ACB_RDV_STATUS_HOST=0.0.0.0
ACB_RDV_RELAY_PORT_START=40000
ACB_RDV_RELAY_PORT_END=40199

# Game settings are set in docker-compose.yml (prebuilt .cxb now, XML submodule + libcxb later).
# ACB_RDV_GAME_STORAGE_FILE_SIZE=58484

ACB_RDV_ALLOW_PRIVATE_SESSIONS=true
# In-game news: anapi (default, the launcher news), empty for none, or a TOML
# file in ./data (e.g. /data/news.toml, see news.example.toml).
# ACB_RDV_NEWS=anapi
# ACB_RDV_NEWS_SENDER=
ACB_RDV_LOG_LEVEL=INFO
# ACB_RDV_PACKET_CAPTURE=/data/packetLog.bin

# NAT traversal switches (see docs/NAT_TRAVERSAL.md), all on by default.
# ACB_RDV_NAT_PUSH_TO_CALLER=false
# ACB_RDV_NAT_RELAY_IN_CONTACTS=false

# Online config (onlineconfigservice.ubi.com) for every game, published on port 80.
# Each game's SandboxUrl points at <address>:<auth port>; the address defaults to
# ACB_RDV_PUBLIC_ADDRESS. ACB's port follows ACB_RDV_AUTH_PORT.
# ONLINECONFIG_PUBLISH_PORT=80
# ONLINECONFIG_PUBLIC_ADDRESS=203.0.113.10
# ONLINECONFIG_ACB_ADDRESS=
# ONLINECONFIG_ACR_ADDRESS=
# ONLINECONFIG_ACR_PORT=21040
